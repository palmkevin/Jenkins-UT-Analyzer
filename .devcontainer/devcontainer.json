{
  "name": "Jenkins-UT-Analyzer",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.dev.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/Jenkins-UT-Analyzer",

  // Only `db` auto-starts with the `dev` service; web/poller/migrate stay down for a fast inner loop.
  "runServices": ["db"],

  "features": {
    // Installs the docker CLI + compose plugin and binds the VM's /var/run/docker.sock, so
    // `docker compose up` from inside the container drives the VM daemon (the full prod-like stack).
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // Installs the Claude Code CLI in the container (native binary, on PATH) + registers the
    // extension. The VS Code panel bundles its own CLI, but this makes `claude` work in the
    // integrated terminal too. Auto-updates by default.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // Installs the GitHub CLI (`gh`) into the image so PRs / branch-protection can be driven from
    // the terminal. Binary only — `gh` has its own auth store (not git's credential helper), so
    // authenticate once per persisted home with `gh auth login`.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Persist Claude Code's login/settings/history across container rebuilds. The base image runs as
  // user `vscode` (home /home/vscode); without this, ~/.claude is discarded and you re-sign-in each
  // rebuild. First run: `claude` in a terminal to authenticate (browser flow).
  // Second volume: `gh` keeps its auth token in ~/.config/gh (its own store, not git's), which would
  // otherwise be discarded on rebuild — persist it so `gh auth login` is a one-time step.
  // Third volume: git's own credential store (~/.config/git/credentials), used for the Bitbucket
  // Cloud push over HTTPS. The VS Code credential helper only forwards credentials the *host* holds,
  // and the container has no SSH key, so Bitbucket needs a stored Atlassian API token — persisted
  // here so it is also a one-time step. See docs/BITBUCKET-MIGRATION.md.
  // NOTE: a named volume mounts empty and *root*-owned (the image has no ~/.config/git to copy
  // ownership from), so until post-create.sh step 4 chowns it, `store` could not write here at all
  // and that "one-time step" silently never happened. Don't drop that chown.
  // Fourth mount: the **one** Atlassian/Redmine credential file on the VM, shared read-only with
  // every devcontainer instead of copied into each. Target `/.claude/` is deliberate, not `~`: the
  // ls-atlassian / ls-redmine resolver (lib/atlassian_common.py) looks for `.claude/settings.local
  // .json` from the cwd *upwards to `/`* before falling back to `~/.claude`, so a file at `/.claude`
  // is found from any working directory — and it stays clear of the `claude-code-config` volume
  // above, so Claude Code's own state and this credential store never fight. Read-only, and host
  // uid 2001110 == container `vscode`, so the host file's 0600 mode is readable as-is. Editing the
  // host file takes effect immediately (the resolver reads it per invocation — no rebuild).
  // NOTE: everything in that file is readable by anything in this container, which runs in
  // bypassPermissions mode — keep the tokens least-privilege (see the skill's scope table).
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=gh-config,target=/home/vscode/.config/gh,type=volume",
    "source=git-credentials,target=/home/vscode/.config/git,type=volume",
    "source=/home/LS/kpa/.claude/settings.local.json,target=/.claude/settings.local.json,type=bind,readonly"
  ],

  "remoteEnv": { "TZ": "Europe/Luxembourg" },

  // Claude Code keeps its OAuth account + per-project trust in `~/.claude.json`, which sits *outside*
  // `~/.claude` — so the volume above does not, on its own, keep you signed in across rebuilds.
  // Pointing CLAUDE_CONFIG_DIR at the same path makes that file land inside the volume too.
  // containerEnv (not remoteEnv) so it applies to every process, including a plain `docker exec`.
  "containerEnv": { "CLAUDE_CONFIG_DIR": "/home/vscode/.claude" },

  // 8000 = in-container `uvicorn --reload`; 8088 = the compose `web` service's published WEB_PORT.
  "forwardPorts": [8000, 8088],

  // Git remote rewrites, the Python env, the Atlassian plugin, and the git credential store — each
  // step is commented in the script. It lives outside this file because the reasoning does not fit
  // in a JSON string, and a six-command `&&` chain is not a thing anyone can safely edit.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
